[Unit]
Description=Kamiwa bounded test outbox and credential rotation
After=postgresql.service

[Service]
Type=oneshot
User=kamiwa
Group=kamiwa
WorkingDirectory=/srv/kamiwa
EnvironmentFile=/etc/kamiwa.env
ExecStart=/srv/kamiwa/.venv/bin/python manage.py run_jobs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=180M
# Background work must yield CPU and disk to web requests.
Nice=10
CPUWeight=20
IOWeight=20
